{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Quadrath Content Bundle v1",
  "type": "object",
  "required": ["format", "format_version", "id", "version", "license", "attribution", "content_sha256", "manifest", "documents", "resources"],
  "properties": {
    "format": {"const": "quadrath-content-bundle"},
    "format_version": {"const": 1},
    "id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "license": {"type": "string", "minLength": 1},
    "attribution": {"type": "string", "minLength": 1},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "manifest": {"type": "object", "required": ["id", "version", "documents"]},
    "documents": {"type": "array", "items": {"type": "object", "required": ["path", "data"], "properties": {"path": {"type": "string"}, "data": {"$ref": "content.schema.json"}}}},
    "resources": {"type": "object", "required": ["handbook", "content_license"], "properties": {"handbook": {"type": "string"}, "content_license": {"type": "string"}}}
  }
}
